<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# Resolve the theme before first paint to avoid a flash of the wrong
       colours: an explicit stored choice wins, otherwise follow the OS. #}
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('theme');
                var theme = stored
                    || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
    <title>{% block title %}Example Blog{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Field notes on cloud infrastructure and AI.{% endblock %}">

    <link rel="icon" href="data:image/svg+xml,&lt;svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22&gt;&lt;circle cx=%2216%22 cy=%2216%22 r=%2215%22 fill=%22%23090b0e%22/&gt;&lt;path d=%22M7 20 A9 9 0 0 1 25 20 Z%22 fill=%22%23E6FB66%22/&gt;&lt;/svg&gt;">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/build/app.css">
    {% block stylesheets %}{% endblock %}
</head>
<body class="min-h-screen flex flex-col">
    <button type="button" data-theme-toggle class="theme-toggle" aria-label="Switch to dark theme" aria-pressed="false">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2"/>
            <path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"/>
        </svg>
    </button>

    <main class="flex-1">
        {% block body %}{% endblock %}
    </main>

    {% include 'partials/_footer.html.twig' %}

    <script src="/build/theme.js" defer></script>
</body>
</html>
